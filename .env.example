# Copy to .env before Docker deployment. Never commit real values.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-a-long-random-password
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 服务端默认大模型（可选）：配置后优先于免key兜底模型使用
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
NEXT_PUBLIC_AMAP_SERVICE_HOST=
HTTP_PORT=80

