# Copy to .env before Docker deployment. Never commit real values.
MYSQL_ROOT_PASSWORD=replace-with-a-long-random-password
MYSQL_PASSWORD=replace-with-a-long-random-password
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_DISPLAY_NAME=平台管理员
SESSION_COOKIE_SECURE=false
# Optional server model; unconfigured requests use an explicit rule-based fallback.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
NEXT_PUBLIC_AMAP_SERVICE_HOST=
HTTP_PORT=80
MODEL_CONFIG_SECRET=replace-with-the-same-long-random-secret
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=超级管理员
FRONTEND_ORIGIN=http://localhost
AMAP_WEB_SERVICE_KEY=
WEB_SEARCH_PROVIDER=baidu
BAIDU_SEARCH_API_KEY=
TAVILY_API_KEY=
SOCIAL_RESEARCH_ENDPOINT=
SOCIAL_RESEARCH_TOKEN=

