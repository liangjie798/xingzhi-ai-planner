NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
NEXT_PUBLIC_AMAP_SERVICE_HOST=
# Leave empty when using the included reverse proxy.
NEXT_PUBLIC_API_BASE_URL=

# Server-only web search. Never prefix search keys with NEXT_PUBLIC_.
WEB_SEARCH_PROVIDER=baidu
BAIDU_SEARCH_API_KEY=
# Optional alternative: WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Backend base URL, shared by the development API proxy and server-side calls.
# If 8080 is occupied, start the backend with -Port 8081 and update this URL.
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
# Account model resolver: must match backend MODEL_CONFIG_SECRET.
MODEL_CONFIG_SECRET=replace-with-the-same-long-random-secret
# Optional server models; separate from the search key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional dedicated AMap REST key (otherwise falls back to the Web JSAPI key).
AMAP_WEB_SERVICE_KEY=
# Optional: Baidu cross-check for POI coordinates. Server-side AK; add SK for SN signing.
BAIDU_MAP_AK=
BAIDU_MAP_SK=
# Optional: OpenStreetMap Overpass endpoint for supplemental parks. Leave empty to disable.
OSM_OVERPASS_URL=
# Optional: reachable Wikivoyage API mirror/proxy; mainland hosts usually cannot reach Wikimedia.
WIKIVOYAGE_API_URL=
SOCIAL_RESEARCH_ENDPOINT=
SOCIAL_RESEARCH_TOKEN=

# Server-only, read-only airline website browser. No airline API key is required.
# Enable only after validating the deployed browser and website access conditions.
AIRLINE_BROWSER_ENABLED=0
# Optional: autodetects Microsoft Edge on Windows and Chromium on Linux.
AIRLINE_BROWSER_EXECUTABLE=

