NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_CODE=
NEXT_PUBLIC_AMAP_SERVICE_HOST=
# Leave empty when using the included reverse proxy.
NEXT_PUBLIC_API_BASE_URL=

# Server-only web search. Never prefix search keys with NEXT_PUBLIC_.
WEB_SEARCH_PROVIDER=baidu
BAIDU_SEARCH_API_KEY=
# Optional alternative: WEB_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Account model resolver: must match backend MODEL_CONFIG_SECRET.
BACKEND_INTERNAL_URL=http://127.0.0.1:8080
MODEL_CONFIG_SECRET=replace-with-the-same-long-random-secret
# Optional server models; separate from the search key.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=Qwen/Qwen2.5-7B-Instruct
# Optional dedicated AMap REST key (otherwise falls back to the Web JSAPI key).
AMAP_WEB_SERVICE_KEY=
SOCIAL_RESEARCH_ENDPOINT=
SOCIAL_RESEARCH_TOKEN=

# Server-only ticket provider. Generate a key at https://cmcp.variflight.com/.
# Do not use NEXT_PUBLIC_ or commit a real key.
VARIFLIGHT_MCP_KEY=

