# Local H2 development. Spring Boot does not automatically load this file.
# Linux/macOS: set -a; . ./.env; set +a
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
SESSION_COOKIE_SECURE=false
MODEL_CONFIG_SECRET=replace-with-the-same-long-random-secret
# Optional administrator bootstrap. No administrator is created with an empty password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=管理员
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_DISPLAY_NAME=超级管理员
# Optional backend Agent model.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
